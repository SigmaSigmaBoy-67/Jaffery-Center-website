+.mobile-nav-panel {
+  position: absolute;
+  right: 0;
+  top: calc(100% + 12px);
+  width: min(360px, calc(100vw - 32px));
+  max-height: calc(100dvh - 92px);
+  overflow: auto;
+  padding: 16px;
+  background: rgba(250, 252, 248, 0.94);
+  border: 1px solid rgba(255, 255, 255, 0.9);
