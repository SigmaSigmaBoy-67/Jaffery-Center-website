+  --glass-gold: rgba(223, 193, 129, .42);
+}
+.glass--crystal {
+  background: linear-gradient(145deg, rgba(255,255,255,.88), var(--glass-crystal));
+  border: 1px solid var(--glass-edge);
+  box-shadow: inset 0 1px white, inset 0 -1px 2px rgba(31,91,70,.13), 0 16px 42px rgba(15,55,45,.11);
+  -webkit-backdrop-filter: blur(20px) saturate(1.3);
+  backdrop-filter: blur(20px) saturate(1.3);
+}
+.glass--frosted {
+  background: linear-gradient(145deg, rgba(255,255,255,.78), var(--glass-frosted));
+  border: 1px solid var(--glass-edge);
+  box-shadow: inset 0 1px white, 0 16px 40px rgba(15,55,45,.09);
+  -webkit-backdrop-filter: blur(14px) saturate(1.15);
+  backdrop-filter: blur(14px) saturate(1.15);
