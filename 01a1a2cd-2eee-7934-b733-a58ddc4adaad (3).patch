+  backdrop-filter: blur(22px) saturate(1.2);
+  box-shadow:
+    0 24px 58px rgba(7, 39, 34, 0.25),
+    inset 0 1px white;
+  visibility: hidden;
+  opacity: 0;
+  pointer-events: none;
+  transform: translateY(-9px) scale(0.98);
