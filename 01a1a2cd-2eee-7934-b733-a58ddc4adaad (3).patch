+.glass--emerald {
+  background: linear-gradient(135deg, rgba(39,96,80,.82), var(--glass-emerald));
+  border: 1px solid var(--glass-gold);
+  box-shadow: inset 0 1px rgba(255,255,255,.18), 0 20px 48px rgba(3,35,29,.22);
+  color: #f8faf5;
+  -webkit-backdrop-filter: blur(16px) saturate(1.1);
+  backdrop-filter: blur(16px) saturate(1.1);
+}
+.glass--soft {
+  background: var(--glass-soft);
+  border: 1px solid rgba(255,255,255,.71);
+  -webkit-backdrop-filter: blur(9px);
+  backdrop-filter: blur(9px);
+}
+/* The header shell stays transparent; only the independent brand and nav float. */
+.site-header.is-scrolled, .site-header.is-scrolled.on-dark {
+  background: transparent;
+  -webkit-backdrop-filter: none;
+  backdrop-filter: none;
+  box-shadow: none;
