+/* Home and interior heroes */
+.home-hero,
+.page-hero {
+  position: relative;
+  overflow: hidden;
+  isolation: isolate;
+  color: #f8faf5;
+  background:
+    radial-gradient(ellipse 75% 80% at 83% 20%, #28615466, transparent 65%),
